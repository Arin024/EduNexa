    "canvas-confetti": "^1.9.4",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "pg": "^8.13.0",
    "pg-mem": "^3.0.14",
    "pngjs": "^7.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
