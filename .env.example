# GROQ_API_KEY: Primary AI provider for Socratic tutoring, explanations, and exam coaching.
GROQ_API_KEY="MY_GROQ_API_KEY"

# GEMINI_API_KEY: Fallback AI provider for high reliability.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# BACHS_API_KEY: Live or Sandbox secret key from your Bachs.io merchant dashboard (sk_live_... or sk_test_...)
BACHS_API_KEY="sk_live_your_bachs_secret_key_here"

# BACHS_WEBHOOK_SECRET: Webhook signing secret from Bachs.io dashboard (whsec_...)
BACHS_WEBHOOK_SECRET="whsec_your_webhook_signing_secret_here"

# BACHS_BASE_URL: Bachs API base URL (Default: https://api.bachs.io)
BACHS_BASE_URL="https://api.bachs.io"
